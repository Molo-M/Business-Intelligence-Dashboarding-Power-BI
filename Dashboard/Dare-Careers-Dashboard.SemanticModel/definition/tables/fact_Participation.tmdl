table fact_Participation
	lineageTag: db862701-0a94-4eaf-b215-aef18828fe03

	column Track
		dataType: string
		isHidden
		lineageTag: a35d67e4-d0e8-4259-9d5c-527d86af7828
		summarizeBy: none
		sourceColumn: Track

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column Week
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: d6a69841-2fcb-43be-8c0a-287a7e8b96ec
		summarizeBy: sum
		sourceColumn: Week

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column Date
		dataType: dateTime
		isHidden
		formatString: Long Date
		lineageTag: fbcade15-d55a-41e3-b786-f44ae8057dc9
		summarizeBy: none
		sourceColumn: Date

		changedProperty = IsHidden

